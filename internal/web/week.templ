package web

import "fmt"

templ weekPage(d weekPageData) {
	@layout(pageTitle(d)) {
		<div class={ "week-page", templ.KV("focus", d.Focus) }>
			<aside class="week-list" aria-label="Week">
				<div class="week-head">
					<h1 class="display">{ d.Week.Label }</h1>
					<nav class="week-nav" aria-label="Change week">
						<a href={ templ.URL(d.Week.PrevURL) } class="icon-btn" aria-label="Previous week">
							@chevronLeft()
						</a>
						<a href={ templ.URL(d.Week.NextURL) } class="icon-btn" aria-label="Next week">
							@chevronRight()
						</a>
					</nav>
				</div>
				<ol class="days">
					for _, day := range d.Week.Days {
						if len(day.Rows) == 0 {
							<li class={ "day-rest", templ.KV("today", day.IsToday) }>
								@dayLabel(day)
								<span>Rest</span>
								if d.IsAdmin {
									<a href={ templ.URL("/trainings/new?date=" + day.ISO) } class="add-link" aria-label={ "Add a training on " + day.Dow + " " + day.Date }>
										@plusIcon()
									</a>
								}
							</li>
						}
						for _, row := range day.Rows {
							<li>
								<a
									href={ templ.URL(row.URL) }
									class={ "day-row", templ.KV("selected", row.Selected), templ.KV("today", day.IsToday), templ.KV("done", row.Done) }
									if row.Selected {
										aria-current="page"
									}
								>
									@dayLabel(day)
									<span class="day-main">
										<span class="day-title">{ row.Title }</span>
										<span class="day-dur">
											if row.Done {
												<span class="done-tag">
													@checkIcon()
													Done
												</span>
												<span aria-hidden="true">·</span>
											}
											{ row.DurLabel }
										</span>
									</span>
									<span class="mini-strip" aria-hidden="true">
										<span style={ templ.SafeCSS(fmt.Sprintf("width:%.1f%%", row.StripW)) }>
											for _, b := range row.Bars {
												<span class={ "bar", zoneCls(b.Zone) } style={ grow(b.Grow) }></span>
											}
										</span>
									</span>
									<span class="row-chevron">
										@chevronRight()
									</span>
								</a>
							</li>
						}
					}
				</ol>
				if d.IsAdmin {
					<a href="/trainings/new" class="pill-btn new-btn">
						@plusIcon()
						New training
					</a>
				}
			</aside>
			<section class="session-pane">
				if d.Session != nil {
					@session(*d.Session, d.Week.URL)
				} else {
					<div class="empty-card">
						<p class="display-sm">No training this week</p>
						<p class="muted">Rest days all round.</p>
					</div>
				}
			</section>
		</div>
	}
}

templ dayLabel(day dayView) {
	<span class="day-label">
		<span class="dow">{ day.Dow }</span>
		<span class="date">{ day.Date }</span>
	</span>
}

templ session(s sessionView, weekURL string) {
	<article class="session" aria-labelledby="session-title">
		<a href={ templ.URL(weekURL) } class="pill-btn back-btn">
			@chevronLeft()
			Week
		</a>
		<header class="session-head">
			<div class="session-title-row">
				<h1 id="session-title" class="display">{ s.Title }</h1>
				if !s.Done {
					<button type="button" class="pill-btn primary" data-open-dialog="done-dialog">
						@checkIcon()
						Mark as done
					</button>
				}
			</div>
			if s.Notes != "" {
				<p class="session-notes">{ s.Notes }</p>
			}
		</header>
		if s.Done {
			<section class="card done-card" aria-label="Your log">
				<div class="done-head">
					<span class="done-badge">
						@checkIcon()
						Done
					</span>
					if s.Feeling != 0 {
						<span class="feeling-tag">
							Felt { feelingLabel(s.Feeling) }
							<span class="muted">{ fmt.Sprintf("%d/5", s.Feeling) }</span>
						</span>
					}
					<button type="button" class="btn btn-small done-edit" data-open-dialog="done-dialog">Edit</button>
				</div>
				if s.CompletionNote != "" {
					<p class="done-note">{ s.CompletionNote }</p>
				}
			</section>
		}
		@doneDialog(s)
		<div class="card chart-card">
			<div class="chart-head">
				<h2 class="display-sm">Intensity</h2>
				<ul class="legend">
					for _, z := range s.Zones {
						<li><span class={ "swatch", zoneCls(z) }></span>{ fmt.Sprintf("Z%d", z) }</li>
					}
				</ul>
			</div>
			<div class="chart" role="img" aria-label={ chartLabel(s) }>
				<div class="chart-bars">
					for _, b := range s.Bars {
						<span class={ "bar", zoneCls(b.Zone), templ.KV("is-sel", b.Set == s.Selected) } data-set={ fmt.Sprint(b.Set) } style={ grow(b.Grow) }></span>
					}
				</div>
			</div>
			<div class="brackets">
				for _, set := range s.Sets {
					<button type="button" class={ "bracket", templ.KV("is-sel", set.Num == s.Selected) } data-set={ fmt.Sprint(set.Num) } data-pick-set={ fmt.Sprint(set.Num) } style={ grow(set.Grow) } aria-label={ fmt.Sprintf("Show set %d", set.Num) }>
						<span class="bracket-line"></span>
						<span class="bracket-num">{ fmt.Sprint(set.Num) }</span>
					</button>
				}
			</div>
			<div class="ticks" aria-hidden="true">
				for _, t := range s.Ticks {
					<span class={ "tick", "tick-" + t.Align } style={ templ.SafeCSS(fmt.Sprintf("left:%.2f%%", t.Left)) }>{ t.Label }</span>
				}
			</div>
			if s.Estimated {
				<p class="chart-note">~ Distance steps are drawn with an estimated pace per zone.</p>
			}
		</div>
		<section class="sets-section" aria-labelledby="sets-title">
			<h2 id="sets-title" class="display-sm">Sets</h2>
			<div class="sets">
				for _, set := range s.Sets {
					<button type="button" class={ "set-card", templ.KV("is-sel", set.Num == s.Selected) } data-set={ fmt.Sprint(set.Num) } data-pick-set={ fmt.Sprint(set.Num) }>
						<span class="set-top">
							<span class="set-num">{ fmt.Sprint(set.Num) }</span>
							<span class="set-titles">
								<span class="set-name">{ set.Name }</span>
								<span class="set-structure">{ set.Structure }</span>
							</span>
							<span class="set-dur">{ set.DurLabel }</span>
						</span>
						<span class="set-details">
							<span class="set-zone">
								<span class={ "swatch", zoneCls(set.Zone) }></span>
								<strong>{ zoneName(set.Zone) }</strong>
							</span>
							for _, e := range set.Extras {
								<span><strong>{ e.Label }</strong> { e.Text }</span>
							}
						</span>
					</button>
				}
			</div>
		</section>
		@comments(s)
	</article>
}

templ comments(s sessionView) {
	<section id="comments" class="comments-section" aria-labelledby="comments-title">
		<h2 id="comments-title" class="display-sm">
			Comments
			if len(s.Comments) > 0 {
				<span class="count">{ fmt.Sprint(len(s.Comments)) }</span>
			}
		</h2>
		<div class="card comments-card">
			if len(s.Comments) > 0 {
				<ol class="comment-list">
					for _, c := range s.Comments {
						<li class={ "comment", templ.KV("mine", c.Mine) }>
							<span class="avatar" aria-hidden="true">{ commentInitial(c.Author) }</span>
							<div class="comment-main">
								<div class="comment-meta">
									<strong>{ c.Author }</strong>
									<span class="muted">{ c.When }</span>
									if c.CanDelete {
										<form method="post" action={ templ.SafeURL(deleteCommentURL(s.ID, c.ID)) } class="comment-delete" hx-confirm="Delete this comment?">
											<button type="submit" class="link-btn">Delete</button>
										</form>
									}
								</div>
								<p class="comment-body">{ c.Body }</p>
							</div>
						</li>
					}
				</ol>
			} else {
				<p class="muted comments-empty">No comments yet.</p>
			}
			<form method="post" action={ templ.SafeURL(commentsURL(s.ID)) } class="comment-form">
				<label for="comment-body" class="visually-hidden">Write a comment</label>
				<textarea id="comment-body" name="body" rows="2" required maxlength={ fmt.Sprint(maxCommentLen) } placeholder="Write a comment…"></textarea>
				<button type="submit" class="btn btn-primary">Post</button>
			</form>
		</div>
	</section>
}

// doneDialog is the "mark as done" modal, opened by the
// data-open-dialog buttons (see app.js).
templ doneDialog(s sessionView) {
	<dialog id="done-dialog" class="modal" aria-labelledby="done-dialog-title" autofocus>
		<form method="post" action={ templ.SafeURL(completionURL(s.ID)) } class="modal-form">
			<div class="modal-head">
				<h2 id="done-dialog-title" class="display-sm">
					if s.Done {
						Edit your log
					} else {
						Mark as done
					}
				</h2>
				<p class="muted">{ s.Title }</p>
			</div>
			<fieldset class="feeling-field">
				<legend>How did it feel? <small class="muted">(optional)</small></legend>
				<div class="feeling-options">
					for f := 1; f < len(feelings); f++ {
						<label class="feeling-option">
							<input type="radio" name="feeling" value={ fmt.Sprint(f) } checked?={ s.Feeling == f }/>
							<span class="feeling-num">{ fmt.Sprint(f) }</span>
							<span class="feeling-label">{ feelingLabel(f) }</span>
						</label>
					}
				</div>
			</fieldset>
			<label class="field">
				<span>Note <small class="muted">(optional)</small></span>
				<textarea name="note" rows="3" maxlength={ fmt.Sprint(maxCompletionNote) } placeholder="Legs felt heavy, nailed the last rep…">{ s.CompletionNote }</textarea>
			</label>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					if s.Done {
						Save
					} else {
						Mark as done
					}
				</button>
				<button type="button" class="btn" data-close-dialog>Cancel</button>
				if s.Done {
					<button type="submit" name="action" value="undo" class="btn btn-ghost-danger">Mark as not done</button>
				}
			</div>
		</form>
	</dialog>
}
